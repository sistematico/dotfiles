[header]
header_visibility = "no"
header_window_color = "default"
volume_color = "green"
state_line_color = "black"

[playlist]
playlist_display_mode = "classic"
song_list_format = $5%a $R$6%t $3%l$9
now_playing_prefix = "» "
#now_playing_suffix = "$/b"
browser_playlist_prefix = "$1»$1 "

[statusbar]
progressbar_look =  "━━━"
progressbar_color = black
statusbar_visibility = yes
progressbar_elapsed_color = green
statusbar_color = 3
song_status_format = {%t - %a}
#display_bitrate = yes

[library]
song_library_format = {{%a - %t}|{%f}}{$R%l}
empty_tag_color = black

[global]
allow_for_physical_item_deletion = yes
song_window_title_format = ncmpcpp: {%a - }{%t}|{%f}
mpd_host = localhost
mpd_port = 6600
mpd_connection_timeout = 5
mpd_music_dir = ~/music
connected_message_on_startup = no
main_window_color = default
centered_cursor = yes
autocenter_mode = yes
#enable_window_title = yes
external_editor = "vim"
execute_on_song_change = notify-send -i /home/lucas/.local/share/icons/Newaita-reborn-dark/devices/64/audio-headphones.svg "$(mpc --format '%artist%' current)" "$(mpc --format '%title%' current)"
visualizer_output_name = FIFO
