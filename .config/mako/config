# Tokyo Night theme for mako

font=JetBrainsMono NFM 11
width=340
height=110
padding=10
margin=10
border-size=2
border-radius=8
icons=1
max-icon-size=48
default-timeout=6000
ignore-timeout=0
layer=overlay
anchor=top-right

background-color=#1a1b26e6
text-color=#c0caf5
border-color=#7aa2f7

progress-color=over #33467c

[urgency=low]
border-color=#565f89
default-timeout=4000

[urgency=normal]
border-color=#7aa2f7

[urgency=high]
border-color=#f7768e
text-color=#f7768e
default-timeout=0

[mode=do-not-disturb]
invisible=1
