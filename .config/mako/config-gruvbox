# Gruvbox Dark theme for mako

font=JetBrainsMono NFM 11
width=360
height=160
padding=10
margin=10
border-size=2
border-radius=8
icons=1
max-icon-size=48
default-timeout=6000
ignore-timeout=0
layer=overlay
anchor=top-right

background-color=#282828e6
text-color=#ebdbb2
border-color=#458588

progress-color=over #3c3836

[urgency=low]
border-color=#928374
default-timeout=4000

[urgency=normal]
border-color=#458588

[urgency=high]
border-color=#fb4934
text-color=#fb4934
default-timeout=0

[mode=do-not-disturb]
invisible=1
