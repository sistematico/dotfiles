#!/usr/bin/env bash
# Shadow wrapper do binario real `rofi` (fica em ~/.local/bin, que vem
# antes de /usr/bin no PATH). So acrescenta um diretorio extra ao
# XDG_DATA_DIRS - usado pelos apps marcados como "esconder so no rofi" via
# rofi-app-hider - e repassa TODOS os argumentos originais, intactos, para
# o rofi de verdade. Isso garante que qualquer flag/modo (-show drun,
# -modes combi -combi-modes "window,drun,run", -dmenu, etc.) continua se
# comportando exatamente como no rofi stock.
set -euo pipefail

# --- DEBUG TEMPORARIO (remover depois de diagnosticar) ---
{
    echo "=== $(date '+%F %T') pid=$$ ppid=$PPID ppid_comm=$(ps -o comm= -p "$PPID" 2>/dev/null) ==="
    echo "argv: $*"
    echo "PATH=$PATH"
} >> "$HOME/.cache/rofi-wrapper-debug.log" 2>&1
# --- FIM DEBUG TEMPORARIO ---

find_real_rofi() {
    local self p
    self=$(readlink -f "${BASH_SOURCE[0]}")
    while IFS= read -r p; do
        [ -x "$p" ] || continue
        [ "$(readlink -f "$p")" = "$self" ] && continue
        printf '%s\n' "$p"
        return 0
    done < <(type -a -p rofi 2>/dev/null)
    return 1
}

REAL_ROFI=$(find_real_rofi || true)
if [ -z "$REAL_ROFI" ]; then
    REAL_ROFI="/usr/bin/rofi"
fi

if [ ! -x "$REAL_ROFI" ]; then
    echo "rofi (wrapper): binario real do rofi nao encontrado" >&2
    exit 127
fi

HIDER_DIR="$HOME/.local/share/rofi-app-hider"
DATA_DIRS="$HIDER_DIR:${XDG_DATA_DIRS:-/usr/local/share/:/usr/share/}"

# So injeta o item "App Hider" quando a chamada e literalmente -show drun
# (nao aparece em run/window/ssh/combi nem nos proprios -dmenu do
# rofi-app-hider, que nao passam -show drun).
is_drun_mode=false
prev=""
for arg in "$@"; do
    if [ "$prev" = "-show" ] && [ "$arg" = "drun" ]; then
        is_drun_mode=true
        break
    fi
    prev="$arg"
done

if [ "$is_drun_mode" = true ]; then
    MENU_ENTRY_DIR="$HIDER_DIR/menu-entry"
    MENU_ENTRY_APPS="$MENU_ENTRY_DIR/applications"
    mkdir -p "$MENU_ENTRY_APPS"
    cat > "$MENU_ENTRY_APPS/rofi-app-hider.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=App Hider
Comment=Esconder/mostrar aplicativos do menu
Exec=$HOME/.local/bin/rofi-app-hider
Icon=view-conceal-symbolic
Terminal=false
EOF
    DATA_DIRS="$MENU_ENTRY_DIR:$DATA_DIRS"
fi

export XDG_DATA_DIRS="$DATA_DIRS"

# --- DEBUG TEMPORARIO ---
{
    echo "REAL_ROFI=$REAL_ROFI"
    echo "is_drun_mode=$is_drun_mode"
    echo "XDG_DATA_DIRS=$XDG_DATA_DIRS"
} >> "$HOME/.cache/rofi-wrapper-debug.log" 2>&1
# --- FIM DEBUG TEMPORARIO ---

exec "$REAL_ROFI" "$@"
